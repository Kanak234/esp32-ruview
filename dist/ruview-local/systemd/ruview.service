[Unit]
Description=RuView WiFi CSI Spatial Sensing Service
After=network-online.target docker.service mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/kanak07/Desktop/esp32/ruview-deployment
EnvironmentFile=/home/kanak07/Desktop/esp32/ruview-deployment/.env
ExecStart=/home/kanak07/Desktop/esp32/ruview-deployment/ruview start
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
