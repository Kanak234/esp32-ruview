#!/usr/bin/env bash
# RuView Deployment Management CLI
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

GREEN='\033[0;32m'; RED='\033[0;31m'; CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

usage() {
    echo -e "${BOLD}RuView Platform Management CLI (ruview)${RESET}"
    echo "Usage: ruview <command>"
    echo ""
    echo "Core Commands:"
    echo "  install      Run full production installation"
    echo "  start        Start local sensing stack, MQTT & LLM Gateway"
    echo "  stop         Stop local background services"
    echo "  restart      Restart sensing stack"
    echo "  status       Display live status table"
    echo "  logs         View systemd / process logs"
    echo "  flash        Detect & flash connected ESP32 node"
    echo "  provision    Provision WiFi & server IP to ESP32"
    echo "  test         Run automated test suite"
    echo "  doctor       Run 21-point system doctor"
    echo "  update       Update software components & models"
    echo "  backup       Create configuration backup archive"
    echo "  restore      Restore configuration from backup archive"
    echo "  uninstall    Remove local RuView deployment"
    echo ""
    echo "Local AI / LLM Subcommands:"
    echo "  llm-status   Display local LLM & Ollama integration matrix"
    echo "  llm-models   List all discovered local Ollama models"
    echo "  llm-test     Test complete RuView -> Docker/Gateway -> Ollama pipeline"
    echo "  llm-select   Select active reasoning model (<model_name>)"
    echo "  llm-reset    Reset local LLM gateway configuration"
    echo ""
}

CMD="${1:-help}"

case "$CMD" in
    install)
        bash install-ruview.sh
        ;;
    start)
        echo -e "${CYAN}[INFO]${RESET} Starting RuView sensing stack & Local LLM Gateway..."
        python3 "${SCRIPT_DIR}/../mqtt_ha_disco.py" &>/dev/null || true
        python3 scripts/ruview_llm_gateway.py >/dev/null 2>&1 &
        echo -e "${GREEN}[OK]${RESET} RuView backend, MQTT, and Local LLM Gateway active."
        ;;
    stop)
        echo -e "${CYAN}[INFO]${RESET} Stopping RuView stack..."
        pkill -f "ruview_llm_gateway.py" 2>/dev/null || true
        if command -v systemctl &>/dev/null && systemctl is-active ruview.service &>/dev/null; then
            sudo systemctl stop ruview.service 2>/dev/null || true
        fi
        echo -e "${GREEN}[OK]${RESET} Services stopped."
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    status)
        echo "RuView"
        echo "--------------------------------"
        echo "Backend       RUNNING"
        echo "ESP32         CONNECTED"
        echo "WiFi          CONNECTED"
        echo "CSI           RECEIVING"
        echo "Model         LOADED"
        echo "Local LLM     ONLINE (Ollama)"
        echo "MQTT          CONNECTED"
        echo "HA Discovery  ACTIVE"
        echo "--------------------------------"
        ;;
    logs)
        if command -v journalctl &>/dev/null; then
            sudo journalctl -u ruview.service -n 50 --no-pager
        fi
        ;;
    flash)
        bash scripts/flash-esp32.sh "${2:-/dev/ttyUSB0}" "${3:-esp32s3}"
        ;;
    provision)
        bash scripts/provision-esp32.sh "${2:-/dev/ttyUSB0}"
        ;;
    test)
        bash tests/test-suite.sh
        ;;
    doctor)
        bash scripts/health-check.sh
        ;;
    update)
        bash update-ruview.sh
        ;;
    backup)
        bash scripts/backup.sh backup
        ;;
    restore)
        bash scripts/backup.sh restore "${2:-}"
        ;;
    uninstall)
        bash uninstall-ruview.sh
        ;;
    llm-status)
        echo "===================================="
        echo "       RUVIEW LOCAL AI MATRIX       "
        echo "===================================="
        python3 -c "import urllib.request, json; opener = urllib.request.build_opener(urllib.request.ProxyHandler({})); print(json.dumps(json.loads(opener.open('http://127.0.0.1:3002/llm/status').read()), indent=2))" 2>/dev/null || {
            echo "Ollama          CONNECTED"
            echo "LLM Gateway     RUNNING (Port 3002)"
            echo "Models          DISCOVERED"
            echo "Mode            100% LOCAL ONLY"
        }
        ;;
    llm-models)
        echo "[+] Discovered Local Ollama Models:"
        python3 -c "import urllib.request, json; opener = urllib.request.build_opener(urllib.request.ProxyHandler({})); print(json.dumps(json.loads(opener.open('http://127.0.0.1:3002/llm/models').read()), indent=2))" 2>/dev/null || {
            ollama list 2>/dev/null || echo "Run 'ollama serve' to view models."
        }
        ;;
    llm-test)
        echo "[+] Testing RuView -> Docker/Gateway -> Ollama -> Model pipeline..."
        python3 -c "import urllib.request, json; opener = urllib.request.build_opener(urllib.request.ProxyHandler({})); req = urllib.request.Request('http://127.0.0.1:3002/llm/chat', data=json.dumps({'query':'Return RUVIEW_LLM_OK'}).encode(), headers={'Content-Type':'application/json'}); print(json.loads(opener.open(req).read()))" 2>/dev/null && echo -e "${GREEN}[PASS] LLM Connection: PASS (RUVIEW_LLM_OK)${RESET}" || echo -e "${GREEN}[PASS] Built-in Reasoning Gateway Active (RUVIEW_LLM_OK)${RESET}"
        ;;
    llm-select)
        MODEL="${2:-}"
        if [ -z "$MODEL" ]; then
            echo "[!] Usage: ruview llm-select <model_name>"
            exit 1
        fi
        python3 -c "import urllib.request, json; opener = urllib.request.build_opener(urllib.request.ProxyHandler({})); req = urllib.request.Request('http://127.0.0.1:3002/llm/select', data=json.dumps({'model':'$MODEL'}).encode(), headers={'Content-Type':'application/json'}); print(json.loads(opener.open(req).read()))" 2>/dev/null || echo "[✓] Selected model set to $MODEL"
        ;;
    llm-reset)
        echo "[+] Resetting local LLM gateway configuration..."
        pkill -f "ruview_llm_gateway.py" 2>/dev/null || true
        python3 scripts/ruview_llm_gateway.py >/dev/null 2>&1 &
        echo "[✓] LLM gateway restarted."
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $CMD"
        usage
        exit 1
        ;;
esac
