# RuView Local Environment & Secret Configuration Template
# Copy this file to .env and configure local WiFi and sensing server parameters.
# NOTE: .env is ignored by Git and secured with chmod 600.

RUVIEW_WIFI_SSID="MyLocalWiFi"
RUVIEW_WIFI_PASSWORD="LocalWiFiPassword123"
RUVIEW_TARGET_IP="192.168.1.100"
RUVIEW_TARGET_PORT="5005"
RUVIEW_MQTT_HOST="127.0.0.1"
RUVIEW_MQTT_PORT="1883"
RUVIEW_MODEL_PATH="models/wifi-densepose-pretrained-4bit"
RUVIEW_NODE_ID="ruview_node_01"
RUVIEW_DEDUP_FACTOR="1.2"
